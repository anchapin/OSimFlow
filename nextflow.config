// =============================================================================
// nextflow.config — OSimFlow global config (skeleton)
// =============================================================================
// See docs/OSimFlow.md §4.3 and §5.2.
// Per-platform resource directives live in conf/<platform>.config.
// =============================================================================

nextflow.enable.dsl = 2

// -----------------------------------------------------------------------------
// Manifest.
// -----------------------------------------------------------------------------
manifest {
    name            = 'osimflow'
    description     = 'Scalable parametric OpenStudio energy simulation campaigns with Nextflow'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.04.0'
    version         = '0.1.0-dev'
}

// -----------------------------------------------------------------------------
// Default params (overridable from the CLI or per-profile).
// -----------------------------------------------------------------------------
params {
    input_variables        = null
    template_sim_package   = null
    n_samples              = 10
    outdir                 = 'results'
    openstudio_version     = '3.4.0'
    archive_intermediates  = false
    custom_apply_script    = null
    custom_kpi_extractor   = null
}

// -----------------------------------------------------------------------------
// Profiles. Each profile enables an execution environment; platform-specific
// process directives live in conf/<profile>.config.
// -----------------------------------------------------------------------------
profiles {

    standard {
        process.executor = 'local'
    }

    docker {
        process.executor = 'local'
        docker.enabled   = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }

    singularity {
        process.executor       = 'local'
        singularity.enabled    = true
        singularity.autoMounts = true
    }

    slurm {
        // Resource defaults are intentionally minimal here; see conf/slurm.config.
        process.executor = 'slurm'
    }

    aws_batch {
        // Resource defaults are intentionally minimal here; see conf/aws_batch.config.
        process.executor = 'awsbatch'
    }

    test {
        // Quick local smoke test: 2 samples, tiny template.
        params.n_samples = 2
    }
}

// -----------------------------------------------------------------------------
// Reports. Emit a Tower-friendly timeline + a top-level trace.
// -----------------------------------------------------------------------------
report {
    enabled   = true
    file      = "${params.outdir}/reports/osimflow_report.html"
    overwrite = true
}

trace {
    enabled   = true
    file      = "${params.outdir}/reports/trace.tsv"
    overwrite = true
    fields    = 'task_id,native_id,name,status,exit,realtime,cpu,%cpu,rss,vmem,peak_rss,peak_vmem,rchar,wchar'
}
