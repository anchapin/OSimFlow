  <class_name>IncreaseInsulationRValueForRoofs</class_name>
  <display_name>Increase R-value of Insulation for Roofs to a Specific Value</display_name>
  <description>Increase R-value of Insulation for Roofs to a Specific Value</description>
  <modeler_description>Does not alter constructions that already are above the R-value requested.</modeler_description>
