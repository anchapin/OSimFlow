# OSimFlow Docker Compose Environment Variables
# Copy to .env and adjust for your local environment

# PostgreSQL (Campaign Registry)
POSTGRES_PASSWORD=osimflow-dev
POSTGRES_PORT=5432

# Redis (Job Queue Backend)
REDIS_PORT=6379

# MLflow (Optional Tracking)
MLFLOW_PORT=5000

# OpenSearch (Observability Backend)
OPENSEARCH_PASSWORD=admin
OPENSEARCH_PORT=9200
OPENSEARCH_DASHBOARD_PORT=5601

# LocalStack (AWS Testing)
LOCALSTACK_PORT=4566
LOCALSTACK_SERVICES=batch,s3,secretsmanager,cloudwatch,logs
LOCALSTACK_DEBUG=1

# AWS (Shared)
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
