// =============================================================================
// conf/slurm.config — on-premise HPC execution profile
// =============================================================================
// Companion to `profiles.slurm` in nextflow.config. Pulls the two images as
// Singularity .sif files. Adjust queue / clusterOptions to match your site.
// =============================================================================

singularity {
    enabled       = true
    autoMounts    = true
    pullPolicy    = 'shifter'
    cacheDir      = "${HOME}/.singularity/cache"
}

process {
    executor        = 'slurm'
    queue           = 'short'
    cpus            = 2
    memory          = '4 GB'
    time            = '2h'

    withName: 'GENERATE_LHS_SAMPLES' {
        container = 'ghcr.io/anchapin/scientific_python_image:latest'
    }
    withName: 'APPLY_PARAMETERS' {
        container = 'ghcr.io/anchapin/scientific_python_image:latest'
    }
    withName: 'EXTRACT_KPIS' {
        container = 'ghcr.io/anchapin/scientific_python_image:latest'
    }
    withName: 'AGGREGATE_RESULTS' {
        container = 'ghcr.io/anchapin/scientific_python_image:latest'
    }
    withName: 'GENERATE_BASIC_PLOTS' {
        container = 'ghcr.io/anchapin/scientific_python_image:latest'
    }
    withName: 'RUN_OPENSTUDIO_SIM' {
        container     = { "ghcr.io/anchapin/openstudio_cli_image:${params.openstudio_version}" }
        cpus          = 4
        memory        = '8 GB'
        time          = '4h'
    }
}
