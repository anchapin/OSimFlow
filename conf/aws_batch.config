// =============================================================================
// conf/aws_batch.config — cloud execution profile
// =============================================================================
// Companion to `profiles.aws_batch` in nextflow.config.
//
// SECURITY (PRD §6): AWS Batch compute environment must use IAM roles for
// EC2 instances — never long-lived access keys. The IAM role is configured
// outside of Nextflow (in the AWS Batch CE), not in this file.
// =============================================================================

aws {
    region = 'us-east-1'
    batch {
        cliPath    = '/home/ec2-user/aws/bin/aws'
        jobRole    = 'arn:aws:iam::${AWS_ACCOUNT_ID}:role/osimflow-batch-job-role'  // set AWS_ACCOUNT_ID env var
        volumes    = '/scratch'
    }
}

process {
    executor        = 'awsbatch'
    queue           = 'osimflow-batch-queue'
    cpus            = 2
    memory          = '4 GB'
    time            = '2h'

    withName: 'GENERATE_LHS_SAMPLES' {
        container = 'ghcr.io/anchapin/scientific_python_image:latest'
    }
    withName: 'APPLY_PARAMETERS' {
        container = 'ghcr.io/anchapin/scientific_python_image:latest'
    }
    withName: 'EXTRACT_KPIS' {
        container = 'ghcr.io/anchapin/scientific_python_image:latest'
    }
    withName: 'AGGREGATE_RESULTS' {
        container = 'ghcr.io/anchapin/scientific_python_image:latest'
    }
    withName: 'GENERATE_BASIC_PLOTS' {
        container = 'ghcr.io/anchapin/scientific_python_image:latest'
    }
    withName: 'RUN_OPENSTUDIO_SIM' {
        container     = { "ghcr.io/anchapin/openstudio_cli_image:${params.openstudio_version}" }
        cpus          = 4
        memory        = '8 GB'
        time          = '4h'
    }
}
