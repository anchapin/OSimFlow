// =============================================================================
// conf/docker.config — local/CI execution profile
// =============================================================================
// Companion to `profiles.docker` in nextflow.config. Sets container references
// for the two pre-built images. Mirrors ghcr.io/anchapain/openstudio_cli_image
// and ghcr.io/anchapin/scientific_python_image (see .github/workflows/).
// =============================================================================

docker {
    enabled = true
    runOptions = '-u $(id -u):$(id -g)'
}

// All "scientific Python" processes share one image.
process {
    withName: 'GENERATE_LHS_SAMPLES' {
        container = 'ghcr.io/anchapin/scientific_python_image:latest'
    }
    withName: 'APPLY_PARAMETERS' {
        container = 'ghcr.io/anchapin/scientific_python_image:latest'
    }
    withName: 'EXTRACT_KPIS' {
        container = 'ghcr.io/anchapin/scientific_python_image:latest'
    }
    withName: 'AGGREGATE_RESULTS' {
        container = 'ghcr.io/anchapin/scientific_python_image:latest'
    }
    withName: 'GENERATE_BASIC_PLOTS' {
        container = 'ghcr.io/anchapin/scientific_python_image:latest'
    }
    // The simulation process gets a *dynamic* tag — set in the .nf file
    // from params.openstudio_version. The default here is the safe fallback.
    withName: 'RUN_OPENSTUDIO_SIM' {
        container = { "ghcr.io/anchapin/openstudio_cli_image:${params.openstudio_version}" }
    }
}
